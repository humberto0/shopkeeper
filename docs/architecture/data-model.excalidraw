   "locked": false,
   "text": "3. FEFO allocation and COGS",
   "originalText": "3. FEFO allocation and COGS",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "cardb2",
   "type": "text",
   "x": 1240,
   "y": 2515.0,
   "width": 520,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1810607154,
   "version": 1,
   "versionNonce": 1083497966,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760572800000,
   "link": null,
   "locked": false,
   "text": "stock_item (variant x location)\n  on_hand 17 = SUM(batches)\n  batch A  exp 2026-11-30   3  R$50\n  batch B  exp 2026-12-31  10  R$55\n  batch C  expired          4  skip\n\nsell 5 un:\n  lock stock_item FOR UPDATE\n  A: -3   B: -2  (FEFO order:\n     expires_on, then received_at)\n  2 stock_movements (kind sale,\n     unit_cost snapshot)\n  sale_items.cogs_cents =\n     3 x 50 + 2 x 55 = R$ 260.00\n\nbatch without cost -> last cost,\n  sales.cogs_estimated = true",
   "originalText": "stock_item (variant x location)\n  on_hand 17 = SUM(batches)\n  batch A  exp 2026-11-30   3  R$50\n  batch B  exp 2026-12-31  10  R$55\n  batch C  expired          4  skip\n\nsell 5 un:\n  lock stock_item FOR UPDATE\n  A: -3   B: -2  (FEFO order:\n     expires_on, then received_at)\n  2 stock_movements (kind sale,\n     unit_cost snapshot)\n  sale_items.cogs_cents =\n     3 x 50 + 2 x 55 = R$ 260.00\n\nbatch without cost -> last cost,\n  sales.cogs_estimated = true",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
