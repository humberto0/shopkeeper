   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "cardb3",
   "type": "text",
   "x": 1850,
   "y": 2515.0,
   "width": 520,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1503068228,
   "version": 1,
   "versionNonce": 963026856,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760572800000,
   "link": null,
   "locked": false,
   "text": "variant_prices.price_cents = Pix/cash\ncard = price x (1 + surcharge_rate)\n  R$ 150.00 x 1.04 = R$ 156.00\n\ndiscount <= roles.max_discount_rate\n  else discount_approvals (owner)\n  approval valid only for the same\n  draft hash, once, 30 min\n\nfloor = cost / (1 - tax - fee - min_margin)\n  61.20 / (1 - 0.04 - 0.01 - 0.10)\n  = R$ 72.00 (applies to owner too)\n\ntarget price = cost / (1 - rates - margin)\n  100 / (1 - 0.04 - 0.03 - 0.10 - 0.20)\n  = R$ 158.73\nmarkup = (p - c) / c   margin = net / p",
   "originalText": "variant_prices.price_cents = Pix/cash\ncard = price x (1 + surcharge_rate)\n  R$ 150.00 x 1.04 = R$ 156.00\n\ndiscount <= roles.max_discount_rate\n  else discount_approvals (owner)\n  approval valid only for the same\n  draft hash, once, 30 min\n\nfloor = cost / (1 - tax - fee - min_margin)\n  61.20 / (1 - 0.04 - 0.01 - 0.10)\n  = R$ 72.00 (applies to owner too)\n\ntarget price = cost / (1 - rates - margin)\n  100 / (1 - 0.04 - 0.03 - 0.10 - 0.20)\n  = R$ 158.73\nmarkup = (p - c) / c   margin = net / p",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
