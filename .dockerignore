# Everything here is excluded from the build context sent to the Docker
# daemon. A smaller context means faster builds and fewer accidental
# secrets baked into the image.

.git
.gitignore
.idea
.vscode

.env
*.env
!.env.example

bin/
tmp/

*_test.go
test/

README.md
*.md

# docs/ itself must stay: docs/docs.go is the swag-generated package imported
# by internal/platform/http/router.go. Only the non-build files are excluded —
# specs, and the swagger.json/yaml copies (docs.go carries its own template).
docs/specs/
docs/swagger.json
docs/swagger.yaml

Dockerfile
.dockerignore
docker-compose.yml
Makefile
