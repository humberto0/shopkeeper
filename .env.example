SERVER_PORT=8080

# Comma-separated list of origins allowed to call the API from a browser.
# "*" allows any origin; restrict this in production.
CORS_ALLOWED_ORIGINS=*

# Canonical database setting: the full DSN. The API, `make migrate-*` and
# the secret manager (`<env>/api/database-url`) all use this same value.
DATABASE_URL=postgres://shopkeeper:changeme@localhost:5432/shopkeeper?sslmode=disable

# Connection pool tuning (optional; defaults shown for the ones commented out).
DB_MAX_CONNECTIONS=10
# DB_MIN_CONNECTIONS=2
# DB_MAX_CONN_IDLE_TIME=5m
# DB_MAX_CONN_LIFETIME=30m

# Local-dev fallback: when DATABASE_URL is empty, the API builds the DSN from
# these parts (only DB_PASSWORD is required). docker-compose also reads them
# to create the local `postgres` container, so keep them in sync with
# DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=shopkeeper
DB_PASSWORD=changeme
DB_NAME=shopkeeper
DB_SSL_MODE=disable
